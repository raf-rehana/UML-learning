        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor transparent\n\ntitle HOSPITAL MANAGEMENT SYSTEM\n\nstart\n\n:Community doctor refers patient;\n:Record reason + planned admission date;\n:Check patient details;\n:Create admission episode;\n:Send admission card;\n\nfork\n  :Send copy to community doctor;\nfork again\n  :Notify patient;\nend fork\n\n:Assign hospital doctor;\n:Offer planned admission date;\n\nif (Patient condition changed?) then (Yes)\n  :Cancel admission;\n  :Record cancellation reason &amp; date;\n  stop\nelse (No)\nendif\n\nif (Need to delay admission?) then (Yes)\n  :Mark as deferred;\n  :Record delay length;\n  :Notify patient &amp; doctor;\n\n  if (Cancel after delay?) then (Yes)\n    :Cancel admission;\n    stop\n  else (No)\n  endif\nelse (No)\nendif\n\n:Patient admitted;\n:Record admission date;\n\n:Make diagnosis;\n:Record diagnosis details;\n\nif (Diagnosis treatable?) then (No)\n  :Discharge patient;\n  :Record discharge date &amp; reason;\n  :Send discharge notes;\n  stop\nelse (Yes)\n  :Mark as treatable;\nendif\n\nfork\n  if (Surgery needed?) then (Yes)\n    :Perform surgery;\n    :Record surgery details;\n  endif\nfork again\n  if (Medication needed?) then (Yes)\n    :Administer medication;\n    :Record medication details;\n  endif\nend fork\n\nrepeat\n  :Continue treatment;\nrepeat while (Treatment complete?) is (No)\n\n:Discharge patient;\n:Record discharge details;\n:Send discharge notes;\n:Give advice to patient;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="Hrv-JRHjJY69cnPdT8Dx-1">
